# =============================================================================
# MCP Client CLI - Environment Configuration
# =============================================================================
# This client authenticates once with the IDP, then connects to multiple MCP
# servers using Cross-App Access (XAA) flow.
# =============================================================================

# -----------------------------------------------------------------------------
# IDP Configuration (Identity Provider - single authentication for all servers)
# -----------------------------------------------------------------------------
IDP_URL=https://idp.xaa.dev
CLIENT_ID=client_b937d8c87440fd73
CLIENT_SECRET=secret_N6rrkW8xLbEPPpAeAdszHdS3cC95ZcSQ
CALLBACK_PORT=3333

# -----------------------------------------------------------------------------
# MCP Server 1: qrty.page
# Uses OAuth Protected Resource Metadata discovery (RFC 9728)
# Auth server auto-discovered from: https://mcp.qrty.page/.well-known/oauth-protected-resource
# -----------------------------------------------------------------------------
MCP_SERVER_1_NAME=qrty
MCP_SERVER_1_URL=https://mcp.qrty.page
MCP_SERVER_1_AUTH_URL=https://auth.resource.xaa.dev
MCP_SERVER_1_AUDIENCE=https://mcp.qrty.page/mcp
MCP_SERVER_1_SCOPES=mcp.access

# -----------------------------------------------------------------------------
# MCP Server 2: xaa.dev
# Explicit configuration (no auto-discovery)
# -----------------------------------------------------------------------------
MCP_SERVER_2_NAME=xaa-dev
MCP_SERVER_2_URL=https://mcp.xaa.dev
MCP_SERVER_2_AUTH_URL=https://auth.resource.xaa.dev
MCP_SERVER_2_AUDIENCE=https://mcp.xaa.dev/mcp
MCP_SERVER_2_SCOPES=todos.read,mcp.access

# -----------------------------------------------------------------------------
# Anthropic API Key (for Claude AI integration)
# Get your key from: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
